# Copy to backend/.env and fill in. Never commit the real .env file.
# Special characters in the password (@ : / #) must be URL-encoded.
DATABASE_URL=postgresql+psycopg://scan2drive_app:YOUR_PASSWORD@localhost:5432/scan2drive

# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# development or production (production refuses a weak SECRET_KEY)
ENVIRONMENT=development

# Address of the web app; car stickers and passenger QR codes link here.
# Testing with phones on the same Wi-Fi: use the laptop's address, e.g. http://192.168.1.23:3000
# (npm run dev:lan prints it). Restart the backend after changing it.
PUBLIC_BASE_URL=http://localhost:3000

# Optional (defaults shown)
# COOKIE_SECURE=            # empty: on in production (HTTPS only), off in development
# STORAGE_DIR=uploads
# MAX_PHOTO_MB=5

# Font with Bangla letters for PDF reports (optional, see README)
# PDF_FONT_PATH=C:/Windows/Fonts/Nirmala.ttf
